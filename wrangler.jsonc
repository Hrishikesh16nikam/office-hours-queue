{
	// Cloudflare Workers config. See DEPLOY.md for the step-by-step setup.
	"name": "officehours",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	// The React app, served by Workers Static Assets (free). Only /api/* runs code.
	"assets": {
		"directory": "./web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Free SQLite database. Replace database_id with the one `npm run cf:db:create` prints.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "office-hours-queue",
			"database_id": "2caf6a50-7c1c-41cc-abdb-c4cf03853955",
			"migrations_dir": "migrations"
		},
		{
			"binding": "office_hours_queue",
			"database_name": "office-hours-queue",
			"database_id": "2caf6a50-7c1c-41cc-abdb-c4cf03853955",
			"remote": true
		}
	],
	// Every 15 minutes: close sessions that ran past their end time and erase old names.
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}